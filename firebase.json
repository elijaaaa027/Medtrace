{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "app/**",
      ".gradle/**",
      "build/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "medtrace-0",
          "region": "asia-east1"
        }
      }
    ]
  }
}
